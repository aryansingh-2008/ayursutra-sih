PORT=4000
JWT_SECRET=change-this-to-a-long-random-string-in-production

# Optional live LLM integration for the AI Clinical Copilot.
# Leave LLM_API_KEY empty to use the built-in explainable rules engine.
LLM_API_KEY=
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini

# Optional timeout for live LLM calls; local rules fallback is used on failure.
LLM_TIMEOUT_MS=8000

# Comma-separated frontend origins. Keep * for a simple demo deployment.
CORS_ORIGIN=*
